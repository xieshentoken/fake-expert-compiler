{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/scan-gold-review-profile.schema.json",
  "title": "Portable Scan Gold Review frozen profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "profile_id", "profile_version", "scope", "structure", "ocr", "evaluation", "privacy"],
  "properties": {
    "schema_version": {"const": "tkc.scan-gold-review-profile/v0.2"},
    "protocol": {"const": "scan-gold-review-v0.2"},
    "compiler_version": {"const": "0.14.7-scan-gold-coverage"},
    "profile_id": {"const": "scan-gold-v0.2"},
    "profile_version": {"const": "0.2"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_page_unit", "one_structure_item_per_physical_page", "one_ocr_item_per_selected_full_region", "candidate_independent_sampling"],
      "properties": {
        "physical_page_unit": {"const": "1-based physical PDF page"},
        "one_structure_item_per_physical_page": {"const": true},
        "one_ocr_item_per_selected_full_region": {"const": true},
        "candidate_independent_sampling": {"const": true}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_values_clockwise", "selected_rotation_is_explicit", "split_axis", "split_boundary_rule", "region_count", "region_order_values", "locked_label_state", "review_label_states", "readability_values", "abnormal_values", "page_status_values", "excluded_items_stay_in_denominator"],
      "properties": {
        "rotation_values_clockwise": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "enum": [0, 90, 180, 270]}},
        "selected_rotation_is_explicit": {"const": true},
        "split_axis": {"const": "x"},
        "split_boundary_rule": {"const": "floor(rotated_width_px/2)"},
        "region_count": {"const": 2},
        "region_order_values": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "enum": ["left-to-right", "right-to-left"]}},
        "locked_label_state": {"const": "candidate"},
        "review_label_states": {"type": "array", "minItems": 4, "items": {"type": "string", "enum": ["confirmed", "unreadable", "not_text", "needs_review"]}},
        "readability_values": {"type": "array", "minItems": 4, "items": {"type": "string", "enum": ["readable", "unreadable", "not_text", "needs_review"]}},
        "abnormal_values": {"type": "array", "minItems": 8, "items": {"type": "string", "enum": ["none", "skew", "crop_loss", "occlusion", "fold", "blur", "other", "needs_review"]}},
        "page_status_values": {"type": "array", "minItems": 4, "items": {"type": "string", "enum": ["complete", "abnormal", "unreadable", "needs_review"]}},
        "excluded_items_stay_in_denominator": {"const": true}
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rule_id", "sampling_page_target", "sampling_page_rule", "slots_per_selected_region", "slots", "selection_inputs", "selection_uses_engine_signal", "selection_uses_candidate_text", "canonical_text_required_for", "decision_values", "excluded_reason_required_for", "coverage_definition", "empty_text_is_not_an_exclusion"],
      "properties": {
        "sample_rule_id": {"const": "region-full-stratified-pages-v2"},
        "sampling_page_target": {"const": 12},
        "sampling_page_rule": {"const": "evenly-spaced-index-round-half-up-v1"},
        "slots_per_selected_region": {"const": 1},
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sample_order", "x0", "y0", "x1", "y1"],
            "properties": {
              "sample_order": {"const": 0},
              "x0": {"const": 0.0},
              "y0": {"const": 0.0},
              "x1": {"const": 1.0},
              "y1": {"const": 1.0}
            }
          }
        },
        "selection_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "selection_uses_engine_signal": {"const": false},
        "selection_uses_candidate_text": {"const": false},
        "canonical_text_required_for": {"const": "complete"},
        "decision_values": {"type": "array", "minItems": 4, "items": {"type": "string", "enum": ["complete", "unreadable", "not_text", "needs_review"]}},
        "excluded_reason_required_for": {"type": "array", "minItems": 3, "items": {"type": "string", "enum": ["unreadable", "not_text", "needs_review"]}},
        "coverage_definition": {"const": "included_complete_full_regions / all_selected_full_region_items"},
        "empty_text_is_not_an_exclusion": {"const": true}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_status", "thresholds", "thresholds_are_frozen", "test_results_cannot_change_thresholds", "overall_verdict", "accuracy_claim"],
      "properties": {
        "threshold_status": {"const": "acceptance-target-candidate"},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure_page_exact_match_min", "structure_coverage_min", "ocr_cer_max", "ocr_wer_max", "numeric_token_accuracy_min", "ocr_sample_coverage_min", "excluded_ratio_max"],
          "properties": {
            "structure_page_exact_match_min": {"type": "number", "minimum": 0, "maximum": 1},
            "structure_coverage_min": {"type": "number", "minimum": 0, "maximum": 1},
            "ocr_cer_max": {"type": "number", "minimum": 0, "maximum": 1},
            "ocr_wer_max": {"type": "number", "minimum": 0, "maximum": 1},
            "numeric_token_accuracy_min": {"type": "number", "minimum": 0, "maximum": 1},
            "ocr_sample_coverage_min": {"type": "number", "minimum": 0, "maximum": 1},
            "excluded_ratio_max": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "thresholds_are_frozen": {"const": true},
        "test_results_cannot_change_thresholds": {"const": true},
        "overall_verdict": {"const": "not-authorized"},
        "accuracy_claim": {"const": false}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_enabled", "external_resources", "source_pdf_included", "hidden_result_fields_included", "compiler_authors_gold", "release_included"],
      "properties": {
        "network_enabled": {"const": false},
        "external_resources": {"const": false},
        "source_pdf_included": {"const": false},
        "hidden_result_fields_included": {"const": false},
        "compiler_authors_gold": {"const": false},
        "release_included": {"const": false}
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tkc.semantic-evidence-binding/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "source_sha256", "package_id", "workpack_id", "local_ref", "object_ids", "atomic_assertion_ids", "support_sha256s", "evidence_ids", "locator", "content_hash", "parser", "parser_version", "render_sha256", "crop_sha256", "review_required", "input_assurance", "evidence_binding_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.semantic-evidence-binding/v0.1"},
    "binding_id": {"type": "string", "pattern": "^sebind-[0-9a-f]{24}$"},
    "source_sha256": {"$ref": "#/$defs/sha"},
    "package_id": {"type": "string", "minLength": 1},
    "workpack_id": {"type": ["string", "null"]},
    "local_ref": {"type": "string", "minLength": 1},
    "object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "atomic_assertion_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "support_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "locator": {"$ref": "#/$defs/locator"},
    "content_hash": {"$ref": "#/$defs/sha"},
    "parser": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "render_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "crop_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "review_required": {"const": true},
    "input_assurance": {"enum": ["legacy-source-support", "atomic-supported", "candidate-source"]},
    "evidence_binding_sha256": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {
      "if": {"properties": {"parser": {"const": "pypdf"}}},
      "then": {"properties": {"locator": {"required": ["physical_page", "printed_label", "printed_label_status", "bbox", "bbox_space", "page_geometry", "bbox_policy", "exact_bbox", "locator_precision", "span_start", "span_end", "page_text_sha256", "text_match_sha256", "visual_review_required"]}}}
    },
    {
      "if": {"properties": {"input_assurance": {"const": "atomic-supported"}}},
      "then": {"properties": {"atomic_assertion_ids": {"minItems": 1}, "support_sha256s": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate_space", "source_box_space", "media_box", "crop_box", "rotation_degrees", "display_width", "display_height", "full_page_bbox", "transform"],
      "properties": {
        "coordinate_space": {"const": "pdf-page-top-left-points-v1"}, "source_box_space": {"const": "pdf-page-bottom-left-points-v1"},
        "media_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "crop_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "rotation_degrees": {"enum": [0, 90, 180, 270]}, "display_width": {"type": "number", "exclusiveMinimum": 0}, "display_height": {"type": "number", "exclusiveMinimum": 0},
        "full_page_bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}},
        "transform": {"type": "object", "additionalProperties": false, "required": ["origin", "rotation_applied", "y_axis"], "properties": {"origin": {"type": "string"}, "rotation_applied": {"type": "integer"}, "y_axis": {"const": "top-left"}}}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["physical_page", "printed_label", "printed_label_status", "visual_review_required"],
      "properties": {
        "physical_page": {"type": "integer", "minimum": 1}, "physical_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "printed_label": {"type": ["string", "null"]}, "printed_label_status": {"type": "string", "minLength": 1},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}},
        "bbox_space": {"const": "pdf-page-top-left-points-v1"}, "page_geometry": {"$ref": "#/$defs/geometry"},
        "bbox_policy": {"enum": ["full-page-candidate", "explicit-candidate-bbox"]}, "exact_bbox": {"type": "boolean"}, "locator_precision": {"type": "string", "minLength": 1},
        "span_start": {"type": "integer", "minimum": 0}, "span_end": {"type": "integer", "minimum": 1},
        "page_text_sha256": {"$ref": "#/$defs/sha"}, "text_match_sha256": {"$ref": "#/$defs/sha"},
        "segment_id": {"type": ["string", "null"]}, "locator": {"type": "object"}, "source_scope": {"type": "object"},
        "visual_review_required": {"type": "boolean"}
      }
    }
  }
}

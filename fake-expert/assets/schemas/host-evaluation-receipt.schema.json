{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/host-evaluation-receipt.schema.json",
  "title": "TKC Host Evaluation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "schema_version", "scorer", "scorer_version", "scorer_sha256", "attestation_level", "record_id", "challenge_id", "attempt", "agent_instance", "host_id", "host_version", "model_id", "package_binding", "challenge_sha256", "expectation_sha256", "run_record_sha256", "checks", "verdict"],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^her-[0-9a-f]{24}$"},
    "schema_version": {"const": "tkc.host-evaluation-receipt/v0.1"},
    "scorer": {"const": "deterministic-host-forward"},
    "scorer_version": {"const": "deterministic-host-forward-scorer-v0.1"},
    "scorer_sha256": {"$ref": "#/$defs/sha256"},
    "attestation_level": {"const": "host-orchestrator-recorded-not-cryptographic"},
    "record_id": {"type": "string", "minLength": 1},
    "challenge_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "agent_instance": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "host_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "package_binding": {"$ref": "#/$defs/package_binding"},
    "challenge_sha256": {"$ref": "#/$defs/sha256"},
    "expectation_sha256": {"$ref": "#/$defs/sha256"},
    "run_record_sha256": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "passed", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "verdict": {"enum": ["passed", "failed"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_version", "manifest_sha256", "integrity_sha256", "adapter_sha256", "runtime_sha256"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "integrity_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

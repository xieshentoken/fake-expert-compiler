{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/portable-visual-recall-submission.schema.json",
  "title": "TKC portable visual recall reviewer submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "workbench_instance_id", "manifest_sha256", "source_sha256", "reviewer_instance", "review_session_id", "declarations", "pages", "exported_at"],
  "properties": {
    "schema_version": {"const": "tkc.portable-visual-recall-submission/v0.1"},
    "protocol": {"const": "portable-visual-recall-review-v0.1"},
    "workbench_instance_id": {"type": "string", "pattern": "^pvrw-[0-9a-f]{20}$"},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "reviewer_instance": {"type": "string"},
    "review_session_id": {"type": "string"},
    "declarations": {"type": "object"},
    "pages": {"type": "array", "minItems": 1},
    "exported_at": {"type": "string", "minLength": 1}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

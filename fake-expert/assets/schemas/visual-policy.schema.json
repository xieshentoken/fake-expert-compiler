{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/visual-policy.schema.json",
  "title": "Selective visual policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "mode", "visual_kinds", "budget", "visual_context", "candidate_only", "promotion", "review_authoring", "network_enabled", "model_download", "silent_fallback", "policy_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.visual-policy/v0.1"},
    "protocol": {"const": "selective-visual-pipeline-v0.1"},
    "mode": {"enum": ["off", "auto", "full"]},
    "visual_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["table", "figure", "chart", "diagram", "equation"]}},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_visual_pages", "max_visual_regions", "max_visual_seconds"],
      "properties": {
        "max_visual_pages": {"type": ["integer", "null"], "minimum": 0},
        "max_visual_regions": {"type": ["integer", "null"], "minimum": 0},
        "max_visual_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "visual_context": {"enum": ["none", "index", "on-demand"]},
    "candidate_only": {"const": true}, "promotion": {"const": false}, "review_authoring": {"const": false},
    "network_enabled": {"const": false}, "model_download": {"const": false}, "silent_fallback": {"const": false},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.2/paddle-runtime-contract.schema.json",
  "title": "TKC external local Paddle runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol", "backend_id", "interpreter", "interpreter_resolved",
    "interpreter_allowlist", "runtime_root", "runtime_allowlist",
    "worker_path", "worker_sha256", "model_root", "model_allowlist",
    "model", "model_status", "runtime_profile", "runtime_inventory", "configuration",
    "configuration_sha256", "network", "network_enabled", "model_download",
    "mcp_http_dependency", "available", "status", "candidate_only",
    "promotion", "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tkc.paddle-runtime-contract/v0.2"},
    "protocol": {"const": "paddle-runtime-contract-v0.2"},
    "backend_id": {"enum": ["paddleocr-ppocrv6", "paddleocr-ppstructure", "paddleocr-ppstructure-v3", "paddleocr-chart-parsing"]},
    "interpreter": {"type": "string", "minLength": 1},
    "interpreter_resolved": {"type": "string", "minLength": 1},
    "interpreter_allowlist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_root": {"type": "string", "minLength": 1},
    "runtime_allowlist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "worker_path": {"type": "string", "minLength": 1},
    "worker_sha256": {"$ref": "#/$defs/hash"},
    "model_root": {"type": "string", "minLength": 1},
    "model_allowlist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "model": {"type": "object", "additionalProperties": true},
    "model_status": {"type": "object", "additionalProperties": true},
    "runtime_profile": {"type": ["object", "null"], "additionalProperties": true},
    "runtime_inventory": {"type": "object", "additionalProperties": true},
    "configuration": {"type": "object", "additionalProperties": true},
    "configuration_sha256": {"$ref": "#/$defs/hash"},
    "network": {"type": "object", "additionalProperties": true},
    "network_enabled": {"const": false},
    "model_download": {"const": false},
    "mcp_http_dependency": {"const": false},
    "available": {"type": "boolean"},
    "status": {"enum": ["ready", "paused"]},
    "candidate_only": {"const": true},
    "promotion": {"const": false},
    "contract_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

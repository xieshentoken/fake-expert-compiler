{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/coverage-ledger.schema.json",
  "title": "TKC Selected-scope Coverage Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "coverage_id", "unit_id", "segment_id", "physical_pages",
    "disposition", "proposal_sha256", "item_refs", "assertion_ids", "rationale",
    "coverage_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tkc.coverage-ledger/v0.1"},
    "coverage_id": {"type": "string", "pattern": "^cov-[0-9a-f]{20}$"},
    "unit_id": {"type": "string", "pattern": "^swu-[0-9a-f]{20}$"},
    "segment_id": {"type": "string", "minLength": 1},
    "physical_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "disposition": {"enum": ["promoted", "context-only", "non-knowledge", "rejected", "gap", "quarantined"]},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "assertion_ids": {"type": "array", "items": {"type": "string", "pattern": "^sa-[0-9a-f]{20}$"}, "uniqueItems": true},
    "rationale": {"type": "string", "minLength": 1},
    "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/scan-gold-review-revision.schema.json",
  "title": "Portable Scan Gold Review private revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "revision_id", "finalized_at", "status", "workbench_instance_id", "workbench_manifest_sha256", "profile_sha256", "plan_sha256", "source_sha256", "scope", "reviewer", "proposer_instance", "submission_sha256", "attestation", "file_hashes", "counts", "issues", "evaluation_allowed", "thresholds_profile_sha256", "threshold_status", "overall_verdict", "policy", "revision_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.scan-gold-review-revision/v0.2"},
    "protocol": {"const": "scan-gold-review-v0.2"},
    "compiler_version": {"const": "0.14.7-scan-gold-coverage"},
    "revision_id": {"type": "string", "minLength": 1},
    "finalized_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["paused-independent-scan-gold", "accepted-for-evaluation"]},
    "workbench_instance_id": {"type": "string", "minLength": 1},
    "workbench_manifest_sha256": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "proposer_instance": {"type": "string", "minLength": 1},
    "submission_sha256": {"$ref": "#/$defs/hash"},
    "attestation": {"$ref": "#/$defs/attestation_meta"},
    "file_hashes": {"$ref": "#/$defs/file_hashes"},
    "counts": {"$ref": "#/$defs/counts"},
    "issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evaluation_allowed": {"type": "boolean"},
    "thresholds_profile_sha256": {"$ref": "#/$defs/hash"},
    "threshold_status": {"const": "acceptance-target-candidate"},
    "overall_verdict": {"const": "not-authorized"},
    "policy": {"$ref": "#/$defs/policy"},
    "revision_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_or_null": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["reviewer_instance", "review_session_id", "proposer_instance"], "properties": {"reviewer_instance": {"type": "string", "minLength": 1}, "review_session_id": {"type": "string", "minLength": 1}, "proposer_instance": {"type": "string", "minLength": 1}}},
    "attestation_meta": {"type": "object", "additionalProperties": false, "required": ["file", "file_sha256", "attestation_id"], "properties": {"file": {"type": ["string", "null"], "minLength": 1}, "file_sha256": {"$ref": "#/$defs/hash_or_null"}, "attestation_id": {"type": ["string", "null"], "minLength": 1}}},
    "file_hashes": {"type": "object", "additionalProperties": false, "required": ["review-submission.json", "scan-gold-structure.jsonl", "scan-gold-ocr.jsonl"], "properties": {"review-submission.json": {"$ref": "#/$defs/hash"}, "external-attestation.json": {"$ref": "#/$defs/hash"}, "scan-gold-structure.jsonl": {"$ref": "#/$defs/hash"}, "scan-gold-ocr.jsonl": {"$ref": "#/$defs/hash"}}},
    "ocr_status_counts": {"type": "object", "additionalProperties": false, "required": ["complete", "needs_review", "not_text", "unreadable"], "properties": {"complete": {"type": "integer", "minimum": 0}, "needs_review": {"type": "integer", "minimum": 0}, "not_text": {"type": "integer", "minimum": 0}, "unreadable": {"type": "integer", "minimum": 0}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["structure_expected", "structure_rows", "structure_included", "structure_excluded", "ocr_expected", "ocr_rows", "ocr_included", "ocr_excluded", "ocr_status_counts", "gold_rows"], "properties": {"structure_expected": {"type": "integer", "minimum": 0}, "structure_rows": {"type": "integer", "minimum": 0}, "structure_included": {"type": "integer", "minimum": 0}, "structure_excluded": {"type": "integer", "minimum": 0}, "ocr_expected": {"type": "integer", "minimum": 0}, "ocr_rows": {"type": "integer", "minimum": 0}, "ocr_included": {"type": "integer", "minimum": 0}, "ocr_excluded": {"type": "integer", "minimum": 0}, "ocr_status_counts": {"$ref": "#/$defs/ocr_status_counts"}, "gold_rows": {"type": "integer", "minimum": 0}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["private", "release_excluded", "compiler_authored_gold", "verified_gold", "promotion_allowed", "executable", "codex_certified", "network_enabled", "model_invocations", "mcp_calls"], "properties": {"private": {"const": true}, "release_excluded": {"const": true}, "compiler_authored_gold": {"const": false}, "verified_gold": {"const": false}, "promotion_allowed": {"const": false}, "executable": {"const": false}, "codex_certified": {"const": false}, "network_enabled": {"const": false}, "model_invocations": {"const": 0}, "mcp_calls": {"const": 0}}}
  }
}

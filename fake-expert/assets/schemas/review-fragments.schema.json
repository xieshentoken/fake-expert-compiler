{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/review-fragments.schema.json",
  "title": "TKC Review Fragment Provenance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workpack_id",
    "merged_at",
    "reviewer_instances",
    "semantic_fragments",
    "visual_fragments",
    "merged_semantic_sha256",
    "merged_visual_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tkc.review-fragments/v0.1"},
    "workpack_id": {"type": "string", "minLength": 1},
    "merged_at": {"type": "string", "format": "date-time"},
    "reviewer_instances": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "semantic_fragments": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
    "visual_fragments": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
    "merged_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "merged_visual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "record_count", "reviewer_instances"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "reviewer_instances": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "item_refs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "pages": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
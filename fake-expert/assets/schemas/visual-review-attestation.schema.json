{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.2/visual-review-attestation.schema.json",
  "title": "TKC externally authored visual review attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "attestation_level", "review_protocol", "reviewer_instance", "proposer_instance", "reviewer_independence", "review_session_id", "review_plan_sha256", "source_sha256", "visual_object_ids", "table_cell_ids", "series_ids", "visual_relation_ids", "relation_sha256s", "table_grid_ids", "table_grid_sha256s", "full_page_sha256", "crop_sha256s", "render_sha256", "render_dpi", "render_rotation", "bbox_sha256s", "input_sha256", "checks", "differences", "verdict", "issue_codes", "rationale", "confidence", "attestation_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.visual-review-attestation/v0.2"},
    "attestation_id": {"type": "string", "pattern": "^vra-[0-9a-f]{20}$"},
    "attestation_level": {"const": "host-orchestrator-recorded-not-cryptographic"},
    "review_protocol": {"const": "visual-review-attestation-v0.2"},
    "reviewer_instance": {"type": "string", "minLength": 1},
    "proposer_instance": {"type": "string", "minLength": 1},
    "reviewer_independence": {"type": "object", "required": ["independent"], "properties": {"independent": {"const": true}, "basis": {"type": "string"}}},
    "review_session_id": {"type": "string", "minLength": 1},
    "review_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visual_object_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "uniqueItems": true},
    "table_cell_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "series_ids": {"type": "array", "items": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "uniqueItems": true},
    "visual_relation_ids": {"type": "array", "items": {"type": "string", "pattern": "^vr-[0-9a-f]{20}$"}, "uniqueItems": true},
    "relation_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "table_grid_ids": {"type": "array", "items": {"type": "string", "pattern": "^tg-[0-9a-f]{20}$"}, "uniqueItems": true},
    "table_grid_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "full_page_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crop_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "render_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "render_dpi": {"type": "integer", "minimum": 36},
    "render_rotation": {"type": "integer", "enum": [0, 90, 180, 270]},
    "bbox_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object", "required": ["source_page_opened", "full_page_opened", "crop_opened", "bbox_checked", "object_type_checked", "relation_checked", "table_grid_checked", "input_hash_checked"], "properties": {"source_page_opened": {"const": true}, "full_page_opened": {"const": true}, "crop_opened": {"const": true}, "bbox_checked": {"const": true}, "object_type_checked": {"const": true}, "relation_checked": {"const": true}, "table_grid_checked": {"const": true}, "input_hash_checked": {"const": true}}, "additionalProperties": {"type": "boolean"}},
    "differences": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["visual_object_id", "status", "observation"], "properties": {"visual_object_id": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "status": {"enum": ["confirmed", "correction-required", "unsupported"]}, "observation": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "verdict": {"enum": ["accepted", "rejected", "quarantined"]},
    "issue_codes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "uniqueItems": true},
    "rationale": {"type": "string", "minLength": 1},
    "confidence": {"type": "object", "required": ["extraction", "interpretation"], "properties": {"extraction": {"type": "number", "minimum": 0, "maximum": 1}, "interpretation": {"type": "number", "minimum": 0, "maximum": 1}}},
    "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/scan-gold-review-workbench-manifest.schema.json",
  "title": "Portable Scan Gold Review workbench manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "created_at", "status", "workbench_instance_id", "reviewer", "profile_file", "profile_sha256", "plan_file", "plan_sha256", "data_file", "data_file_sha256", "source_identity", "item_counts", "asset_count", "assets", "assets_sha256", "policy", "immutable_inputs", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.scan-gold-review-workbench-manifest/v0.2"},
    "protocol": {"const": "scan-gold-review-v0.2"},
    "compiler_version": {"const": "0.14.7-scan-gold-coverage"},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"const": "paused-independent-scan-gold"},
    "workbench_instance_id": {"type": "string", "minLength": 1},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "profile_file": {"type": "string", "minLength": 1},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "plan_file": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "data_file": {"type": "string", "minLength": 1},
    "data_file_sha256": {"$ref": "#/$defs/hash"},
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "item_counts": {"$ref": "#/$defs/item_counts"},
    "asset_count": {"type": "integer", "minimum": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "assets_sha256": {"$ref": "#/$defs/hash"},
    "policy": {"$ref": "#/$defs/policy"},
    "immutable_inputs": {"const": true},
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_instance", "review_session_id", "proposer_instance"],
      "properties": {"reviewer_instance": {"type": "string", "minLength": 1}, "review_session_id": {"type": "string", "minLength": 1}, "proposer_instance": {"type": "string", "minLength": 1}}
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "scope", "source_pdf_included"],
      "properties": {"source_sha256": {"$ref": "#/$defs/hash"}, "scope": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "source_pdf_included": {"const": false}}
    },
    "item_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_items", "ocr_samples", "total_items"],
      "properties": {"structure_items": {"type": "integer", "minimum": 1}, "ocr_samples": {"type": "integer", "minimum": 1}, "total_items": {"type": "integer", "minimum": 2}}
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "physical_page", "sha256", "dimensions_px"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["context", "region", "text-sample"]},
        "physical_page": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "dimensions_px": {"$ref": "#/$defs/dimensions"},
        "region_id": {"type": "string", "minLength": 1},
        "sample_id": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_enabled", "external_resources", "source_pdf_included", "hidden_result_fields_included", "compiler_authored_gold", "release_included"],
      "properties": {"network_enabled": {"const": false}, "external_resources": {"const": false}, "source_pdf_included": {"const": false}, "hidden_result_fields_included": {"const": false}, "compiler_authored_gold": {"const": false}, "release_included": {"const": false}}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/paddle-runtime-split-qualification.schema.json",
  "title": "TKC local Paddle split-bound runtime qualification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol", "compiler_version", "plan_sha256", "qualification_tool_sha256",
    "qualification_id", "backend_id", "profile_id", "runtime_contract_sha256", "split_contract_sha256",
    "split_core_sha256", "split_region_id", "content_rotation_clockwise", "runtime_inventory_sha256",
    "model_identity_sha256", "configuration_sha256", "worker_sha256", "profile_sha256", "fixture",
    "execution", "runtime_warnings", "resource_policy", "qualification", "tested_at",
    "source_pdf_passed", "network_enabled", "model_download", "mcp_http_dependency", "candidate_only",
    "promotion", "verified_gold", "accuracy_claim", "private_host_receipt", "release_included", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tkc.paddle-runtime-split-qualification/v0.1"},
    "protocol": {"const": "paddle-runtime-split-qualification-v0.1"},
    "compiler_version": {"const": "0.14.5-scan-split-checkpoint"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "qualification_tool_sha256": {"$ref": "#/$defs/hash"},
    "qualification_id": {"type": "string", "pattern": "^pqr-[0-9a-f]{24}$"},
    "backend_id": {"const": "paddleocr-ppocrv6"},
    "profile_id": {"const": "technical-text-v1"},
    "runtime_contract_sha256": {"$ref": "#/$defs/hash"},
    "split_contract_sha256": {"$ref": "#/$defs/hash"},
    "split_core_sha256": {"$ref": "#/$defs/hash"},
    "split_region_id": {"type": "string", "minLength": 1},
    "content_rotation_clockwise": {"enum": [0, 90, 180, 270]},
    "runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "model_identity_sha256": {"$ref": "#/$defs/hash"},
    "configuration_sha256": {"$ref": "#/$defs/hash"},
    "worker_sha256": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "fixture": {"type": "object"},
    "execution": {"type": "object"},
    "runtime_warnings": {"type": "object"},
    "resource_policy": {"type": "object"},
    "qualification": {"type": "object"},
    "tested_at": {"type": "string"},
    "source_pdf_passed": {"const": false},
    "network_enabled": {"const": false},
    "model_download": {"const": false},
    "mcp_http_dependency": {"const": false},
    "candidate_only": {"const": true},
    "promotion": {"const": false},
    "verified_gold": {"const": false},
    "accuracy_claim": {"const": false},
    "private_host_receipt": {"const": true},
    "release_included": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

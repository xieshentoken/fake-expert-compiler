{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/visual-review-adjudication-manifest.schema.json",
  "title": "TKC private independent visual adjudication workbench manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "created_at", "status", "workbench_instance_id", "adjudicator", "workpack_identity", "source_submissions", "dispute_set_sha256", "item_count", "items", "assets", "ui_policy", "data_file_sha256", "release_included", "immutable", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.visual-review-adjudication-manifest/v0.1"},
    "protocol": {"const": "visual-review-adjudication-v0.1"},
    "compiler_version": {"const": "0.14.1-visual-review-adjudication"},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"const": "ready"},
    "workbench_instance_id": {"type": "string", "minLength": 1},
    "adjudicator": {"$ref": "#/$defs/adjudicator"},
    "workpack_identity": {"$ref": "#/$defs/identity"},
    "source_submissions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sourceSubmission"}},
    "dispute_set_sha256": {"$ref": "#/$defs/hash"},
    "item_count": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assets": {"type": "array", "items": {"type": "object"}},
    "ui_policy": {"$ref": "#/$defs/uiPolicy"},
    "data_file_sha256": {"$ref": "#/$defs/hash"},
    "release_included": {"const": false},
    "immutable": {"const": true},
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["workpack_sha256", "phase7d5a_manifest_sha256", "phase7d5a_manifest_file_sha256", "candidate_items_file_sha256", "split_commitment_sha256", "split_file_sha256", "review_plan_sha256", "candidate_set_sha256", "item_count", "item_bindings"], "properties": {"workpack_sha256": {"$ref": "#/$defs/hash"}, "phase7d5a_manifest_sha256": {"$ref": "#/$defs/hash"}, "phase7d5a_manifest_file_sha256": {"$ref": "#/$defs/hash"}, "candidate_items_file_sha256": {"$ref": "#/$defs/hash"}, "split_commitment_sha256": {"$ref": "#/$defs/hash"}, "split_file_sha256": {"$ref": "#/$defs/hash"}, "review_plan_sha256": {"$ref": "#/$defs/hash"}, "candidate_set_sha256": {"$ref": "#/$defs/hash"}, "item_count": {"const": 31}, "item_bindings": {"type": "array", "minItems": 31, "items": {"type": "object"}}}},
    "adjudicator": {"type": "object", "additionalProperties": false, "required": ["adjudicator_instance", "adjudication_session_id", "role"], "properties": {"adjudicator_instance": {"type": "string", "minLength": 1}, "adjudication_session_id": {"type": "string", "minLength": 1}, "role": {"const": "third-party-independent"}}},
    "sourceSubmission": {"type": "object", "additionalProperties": false, "required": ["reviewer_instance", "review_session_id", "workbench_instance_id", "submission_sha256"], "properties": {"reviewer_instance": {"type": "string", "minLength": 1}, "review_session_id": {"type": "string", "minLength": 1}, "workbench_instance_id": {"type": "string", "minLength": 1}, "submission_sha256": {"$ref": "#/$defs/hash"}}},
    "uiPolicy": {"type": "object", "additionalProperties": false, "required": ["network_enabled", "external_resources", "split_labels_visible", "prediction_or_model_fields_present", "score_fields_present", "reviewer_results_visible", "adjudicator_answers_preselected", "autosave_namespace"], "properties": {"network_enabled": {"const": false}, "external_resources": {"const": false}, "split_labels_visible": {"const": false}, "prediction_or_model_fields_present": {"const": false}, "score_fields_present": {"const": false}, "reviewer_results_visible": {"const": true}, "adjudicator_answers_preselected": {"const": false}, "autosave_namespace": {"type": "string", "minLength": 1}}}
  }
}

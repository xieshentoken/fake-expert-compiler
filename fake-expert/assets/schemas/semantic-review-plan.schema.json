{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tkc.semantic-review-plan/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_plan_id", "review_plan_sha256", "protocol", "workpack_id", "created_at", "source_sha256", "attestation_level", "reviewer_registry", "proposer_instances", "items", "state", "attestation_authoring_allowed", "promotion_allowed", "resolution_policy"],
  "properties": {
    "schema_version": {"const": "tkc.semantic-review-plan/v0.1"},
    "review_plan_id": {"type": "string", "pattern": "^scrplan-[0-9a-f]{24}$"},
    "review_plan_sha256": {"$ref": "#/$defs/sha"},
    "protocol": {"const": "cross-source-review-v0.1"},
    "workpack_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "source_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha"}},
    "attestation_level": {"const": "host-orchestrator-recorded-not-cryptographic"},
    "reviewer_registry": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "proposer_instances": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "state": {"enum": ["pending-independent-review", "pending-no-candidates", "blocked"]},
    "attestation_authoring_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "resolution_policy": {"const": "preserve-separate-no-consensus"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "item_type", "required_reviewer_count", "risk_tier", "reasons", "candidate_sha256", "evidence_binding_ids", "status"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1}, "item_type": {"enum": ["alignment_candidate", "difference", "conflict", "unit_map"]},
        "required_reviewer_count": {"type": "integer", "minimum": 1, "maximum": 2}, "risk_tier": {"enum": ["ordinary", "high"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}, "candidate_sha256": {"$ref": "#/$defs/sha"},
        "evidence_binding_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sebind-[0-9a-f]{24}$"}},
        "status": {"const": "pending"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/scan-gold-review-evaluation.schema.json",
  "title": "Portable Scan Gold Review evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "evaluated_at", "status", "evaluator_id", "workbench_instance_id", "revision_sha256", "plan_sha256", "profile_sha256", "prediction_file_sha256", "metrics", "thresholds", "threshold_status", "thresholds_source_profile_sha256", "verdict", "accuracy_claim", "issues", "policy", "evaluation_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.scan-gold-review-evaluation/v0.2"},
    "protocol": {"const": "scan-gold-review-v0.2"},
    "compiler_version": {"const": "0.14.7-scan-gold-coverage"},
    "evaluated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["evaluated", "paused", "not-run"]},
    "evaluator_id": {"type": "string", "minLength": 1},
    "workbench_instance_id": {"type": ["string", "null"], "minLength": 1},
    "revision_sha256": {"$ref": "#/$defs/hash_or_null"},
    "plan_sha256": {"$ref": "#/$defs/hash_or_null"},
    "profile_sha256": {"$ref": "#/$defs/hash_or_null"},
    "prediction_file_sha256": {"$ref": "#/$defs/hash_or_null"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "thresholds": {"$ref": "#/$defs/thresholds_or_null"},
    "threshold_status": {"const": "acceptance-target-candidate"},
    "thresholds_source_profile_sha256": {"$ref": "#/$defs/hash_or_null"},
    "verdict": {"const": "not-authorized"},
    "accuracy_claim": {"const": false},
    "issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "policy": {"$ref": "#/$defs/policy"},
    "evaluation_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_or_null": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_page_exact_match_min", "structure_coverage_min", "ocr_cer_max", "ocr_wer_max", "numeric_token_accuracy_min", "ocr_sample_coverage_min", "excluded_ratio_max"],
      "properties": {"structure_page_exact_match_min": {"type": "number", "minimum": 0, "maximum": 1}, "structure_coverage_min": {"type": "number", "minimum": 0, "maximum": 1}, "ocr_cer_max": {"type": "number", "minimum": 0, "maximum": 1}, "ocr_wer_max": {"type": "number", "minimum": 0, "maximum": 1}, "numeric_token_accuracy_min": {"type": "number", "minimum": 0, "maximum": 1}, "ocr_sample_coverage_min": {"type": "number", "minimum": 0, "maximum": 1}, "excluded_ratio_max": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "thresholds_or_null": {"oneOf": [{"$ref": "#/$defs/thresholds"}, {"type": "null"}]},
    "metric_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {"value": {"type": ["number", "null"]}, "status": {"enum": ["computed", "not-run"]}}
    },
    "metric_structure_exact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {"value": {"type": ["number", "null"]}, "status": {"enum": ["computed", "not-run"]}, "correct": {"type": "integer", "minimum": 0}, "eligible": {"type": "integer", "minimum": 0}}
    },
    "metric_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {"value": {"type": ["number", "null"]}, "status": {"enum": ["computed", "not-run"]}, "included": {"type": "integer", "minimum": 0}, "expected": {"type": "integer", "minimum": 0}}
    },
    "metric_distance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {"value": {"type": ["number", "null"]}, "status": {"enum": ["computed", "not-run"]}, "distance": {"type": "integer", "minimum": 0}, "reference_characters": {"type": "integer", "minimum": 0}, "reference_words": {"type": "integer", "minimum": 0}}
    },
    "metric_numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {"value": {"type": ["number", "null"]}, "status": {"enum": ["computed", "not-run"]}, "correct": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}
    },
    "metric_excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {"value": {"oneOf": [{"$ref": "#/$defs/excluded_value"}, {"type": "null"}]}, "status": {"enum": ["computed", "not-run"]}}
    },
    "excluded_value": {"type": "object", "additionalProperties": false, "required": ["structure", "ocr", "ocr_status_counts"], "properties": {"structure": {"type": "integer", "minimum": 0}, "ocr": {"type": "integer", "minimum": 0}, "ocr_status_counts": {"$ref": "#/$defs/ocr_status_counts"}}},
    "ocr_status_counts": {"type": "object", "additionalProperties": false, "required": ["complete", "needs_review", "not_text", "unreadable"], "properties": {"complete": {"type": "integer", "minimum": 0}, "needs_review": {"type": "integer", "minimum": 0}, "not_text": {"type": "integer", "minimum": 0}, "unreadable": {"type": "integer", "minimum": 0}}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_exact_match", "structure_coverage", "ocr_cer", "ocr_wer", "numeric_token_accuracy", "ocr_sample_coverage", "excluded_counts"],
      "properties": {
        "structure_exact_match": {"$ref": "#/$defs/metric_structure_exact"},
        "structure_coverage": {"$ref": "#/$defs/metric_coverage"},
        "ocr_cer": {"$ref": "#/$defs/metric_distance"},
        "ocr_wer": {"$ref": "#/$defs/metric_distance"},
        "numeric_token_accuracy": {"$ref": "#/$defs/metric_numeric"},
        "ocr_sample_coverage": {"$ref": "#/$defs/metric_coverage"},
        "excluded_counts": {"$ref": "#/$defs/metric_excluded"}
      }
    },
    "policy": {"type": "object", "additionalProperties": false, "required": ["private", "release_excluded", "test_cannot_change_threshold", "promotion_allowed", "executable", "codex_certified", "network_enabled", "model_invocations", "mcp_calls"], "properties": {"private": {"const": true}, "release_excluded": {"const": true}, "test_cannot_change_threshold": {"const": true}, "promotion_allowed": {"const": false}, "executable": {"const": false}, "codex_certified": {"const": false}, "network_enabled": {"const": false}, "model_invocations": {"const": 0}, "mcp_calls": {"const": 0}}}
  }
}

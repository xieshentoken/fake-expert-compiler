{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/scan-gold-review-prediction.schema.json",
  "title": "Private evaluator input for Scan Gold Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "source_type", "plan_sha256", "profile_sha256", "structure_pages", "ocr_samples"],
  "properties": {
    "schema_version": {"const": "tkc.scan-gold-review-prediction/v0.2"},
    "protocol": {"const": "scan-gold-review-v0.2"},
    "compiler_version": {"const": "0.14.7-scan-gold-coverage"},
    "source_type": {"const": "private-evaluator-input"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "structure_pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/structure_row"}},
    "ocr_samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ocr_row"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_structure": {"type": "object", "additionalProperties": false, "required": ["source_sha256", "context_sha256", "split_contract_sha256", "region_sha256s"], "properties": {"source_sha256": {"$ref": "#/$defs/hash"}, "context_sha256": {"$ref": "#/$defs/hash"}, "split_contract_sha256": {"$ref": "#/$defs/hash"}, "region_sha256s": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}}},
    "input_ocr": {"type": "object", "additionalProperties": false, "required": ["source_sha256", "context_sha256", "region_sha256", "sample_sha256", "sample_bbox_sha256"], "properties": {"source_sha256": {"$ref": "#/$defs/hash"}, "context_sha256": {"$ref": "#/$defs/hash"}, "region_sha256": {"$ref": "#/$defs/hash"}, "sample_sha256": {"$ref": "#/$defs/hash"}, "sample_bbox_sha256": {"$ref": "#/$defs/hash"}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["region_id", "printed_page_label", "bbox_pdf_points"], "properties": {"region_id": {"type": "string", "minLength": 1}, "printed_page_label": {"type": ["string", "null"]}, "bbox_pdf_points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}}},
    "structure_row": {"type": "object", "additionalProperties": false, "required": ["item_id", "item_sha256", "input_hashes", "rotation_clockwise", "boundary_px", "region_order", "regions"], "properties": {"item_id": {"type": "string", "minLength": 1}, "item_sha256": {"$ref": "#/$defs/hash"}, "input_hashes": {"$ref": "#/$defs/input_structure"}, "rotation_clockwise": {"type": "integer", "enum": [0, 90, 180, 270]}, "boundary_px": {"type": "integer", "minimum": 1}, "region_order": {"enum": ["left-to-right", "right-to-left"]}, "regions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/region"}}}},
    "ocr_row": {"type": "object", "additionalProperties": false, "required": ["item_id", "item_sha256", "input_hashes", "text"], "properties": {"item_id": {"type": "string", "minLength": 1}, "item_sha256": {"$ref": "#/$defs/hash"}, "input_hashes": {"$ref": "#/$defs/input_ocr"}, "text": {"type": "string"}}}
  }
}

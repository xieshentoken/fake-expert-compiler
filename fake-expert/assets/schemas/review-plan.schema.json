{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/review-plan.schema.json",
  "title": "TKC Orchestrator Review Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_level",
    "issued_by",
    "issued_at",
    "source_sha256",
    "workpack_id",
    "bundle_sha256",
    "proposer_instances",
    "reviewer_instances",
    "semantic_item_count",
    "visual_page_count",
    "gap_resolution_policy",
    "authorization_sha256",
    "review_protocol",
    "review_session_id"
  ],
  "properties": {
    "schema_version": {"const": "tkc.review-plan/v0.1"},
    "attestation_level": {"const": "host-orchestrator-recorded-not-cryptographic"},
    "issued_by": {"const": "host-orchestrator"},
    "issued_at": {"type": "string", "format": "date-time"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workpack_id": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposer_instances": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reviewer_instances": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "semantic_item_count": {"type": "integer", "minimum": 0},
    "visual_page_count": {"type": "integer", "minimum": 0},
    "gap_resolution_policy": {"const": "explicit-package-scope-v1"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_protocol": {"enum": ["separate-source-render-review-v1", "atomic-support-review-v2"]},
    "visual_review_protocol": {"const": "visual-review-attestation-v0.2"},
    "visual_review_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visual_object_count": {"type": "integer", "minimum": 0},
    "visual_attestation_count": {"type": "integer", "minimum": 0},
    "visual_reviewer_requirements": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "review_session_id": {"type": "string", "pattern": "^rws-[0-9a-f]{20}$"},
    "semantic_queue": {"type": "string", "minLength": 1},
    "visual_queue": {"type": "string", "minLength": 1},
    "render_profile": {"type": ["object", "null"]},
    "source_review_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "compiler_version", "assertion_count", "support_count", "coverage_count", "assertion_bundle_sha256", "support_bundle_sha256", "coverage_bundle_sha256"],
      "properties": {
        "protocol": {"const": "atomic-support-review-v2"},
        "compiler_version": {"const": "0.5.0-semantic-assurance"},
        "assertion_count": {"type": "integer", "minimum": 0},
        "support_count": {"type": "integer", "minimum": 0},
        "coverage_count": {"type": "integer", "minimum": 0},
        "assertion_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "support_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

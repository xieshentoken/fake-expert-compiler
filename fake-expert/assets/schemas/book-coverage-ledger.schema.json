{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.2/book-coverage-ledger.schema.json",
  "title": "TKC whole-book planning coverage ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book_plan_id", "record_id", "scope_kind", "physical_pages", "planning_status", "promotion_status", "module_id", "route_ids", "input_sha256", "rationale", "coverage_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.book-coverage-ledger/v0.2"},
    "book_plan_id": {"type": "string", "pattern": "^bpl-[0-9a-f]{20}$"},
    "record_id": {"type": "string", "minLength": 1},
    "scope_kind": {"enum": ["physical_page", "segment"]},
    "physical_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "planning_status": {"enum": ["compile", "context-only", "non-knowledge", "ocr-candidate", "visual-review", "gap", "quarantined"]},
    "promotion_status": {"enum": ["not-started", "candidate-only", "promoted", "blocked"]},
    "module_id": {"type": "string", "pattern": "^mod-[0-9a-f]{20}$"},
    "route_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "rationale": {"type": "string", "minLength": 1},
    "coverage_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

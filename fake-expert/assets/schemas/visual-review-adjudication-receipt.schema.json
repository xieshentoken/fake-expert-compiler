{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/visual-review-adjudication-receipt.schema.json",
  "title": "TKC independent visual adjudication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "receipt_id", "workbench_instance_id", "adjudication_manifest_sha256", "workpack_identity", "source_submissions", "source_submission_sha256s", "adjudication_submission_sha256", "dispute_set_sha256", "adjudicator", "declarations", "item_count", "resolved_dispute_count", "items", "finalization_status", "import_compatible", "verified_gold", "promotion_allowed", "release_included", "issues", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.visual-review-adjudication-receipt/v0.1"},
    "protocol": {"const": "visual-review-adjudication-v0.1"},
    "compiler_version": {"const": "0.14.1-visual-review-adjudication"},
    "receipt_id": {"type": "string", "minLength": 1},
    "workbench_instance_id": {"type": "string", "minLength": 1},
    "adjudication_manifest_sha256": {"$ref": "#/$defs/hash"},
    "workpack_identity": {"type": "object"},
    "source_submissions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "source_submission_sha256s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/hash"}},
    "adjudication_submission_sha256": {"$ref": "#/$defs/hash"},
    "dispute_set_sha256": {"$ref": "#/$defs/hash"},
    "adjudicator": {"type": "object"},
    "declarations": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "item_count": {"type": "integer", "minimum": 1},
    "resolved_dispute_count": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "items": {"type": "object"}},
    "finalization_status": {"enum": ["paused", "accepted-for-import"]},
    "import_compatible": {"type": "boolean"},
    "verified_gold": {"const": false},
    "promotion_allowed": {"const": false},
    "release_included": {"const": false},
    "issues": {"type": "array", "items": {"type": "string"}},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

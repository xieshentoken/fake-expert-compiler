{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tkc.science-calculation-receipt/v0.1",
  "title": "Science scalar calculation receipt and explicit input contracts",
  "$ref": "#/$defs/receipt",
  "$defs": {
    "calculation_record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "material_state",
        "method_ref",
        "sample_identity",
        "orientation_frame",
        "conditions",
        "mode",
        "axis",
        "coordinate"
      ],
      "properties": {
        "observation": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "material_state": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "method_ref": {
          "$ref": "science-sidecar.schema.json#/$defs/object_ref"
        },
        "sample_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "orientation_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "conditions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
              },
              "value": {
                "$ref": "science-sidecar.schema.json#/$defs/quantity"
              }
            }
          }
        },
        "mode": {
          "enum": [
            "scalar",
            "linear"
          ]
        },
        "axis": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "quantity_kind",
                "frame"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
                },
                "quantity_kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "frame": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            {
              "const": null
            }
          ]
        },
        "coordinate": {
          "oneOf": [
            {
              "$ref": "science-sidecar.schema.json#/$defs/quantity"
            },
            {
              "const": null
            }
          ]
        }
      }
    },
    "calculation_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "request"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "selection"
          ],
          "properties": {
            "kind": {
              "const": "property"
            },
            "selection": {
              "$ref": "#/$defs/selection"
            }
          }
        }
      ]
    },
    "calculation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "symbol_binding",
        "source",
        "basis"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
        },
        "symbol_binding": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "source": {
          "$ref": "#/$defs/calculation_source"
        },
        "basis": {
          "enum": [
            "not-applicable",
            "mass",
            "volume",
            "mole"
          ]
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol",
        "request_sha256",
        "base_package",
        "sidecar_sha256",
        "formula_card",
        "input_bindings",
        "output_symbol_binding",
        "condition_bindings"
      ],
      "properties": {
        "schema_version": {
          "const": "tkc.science-calculation/v0.1"
        },
        "protocol": {
          "const": "science-calculation-v0.1"
        },
        "request_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "base_package": {
          "$ref": "science-consultation.schema.json#/$defs/fingerprint"
        },
        "sidecar_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "formula_card": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "input_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/calculation_binding"
          }
        },
        "output_symbol_binding": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "condition_bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "name",
              "request_name",
              "property_symbol"
            ],
            "properties": {
              "source": {
                "enum": [
                  "request",
                  "property"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
              },
              "request_name": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
                  },
                  {
                    "const": null
                  }
                ]
              },
              "property_symbol": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
                  },
                  {
                    "const": null
                  }
                ]
              }
            }
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_sha256",
        "host_instance",
        "session_id",
        "issued_at",
        "expires_at",
        "allow_execution",
        "network",
        "write_package",
        "attestation_level"
      ],
      "properties": {
        "schema_version": {
          "const": "tkc.science-execution-permission/v0.1"
        },
        "plan_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "host_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "issued_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expires_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "allow_execution": {
          "const": true
        },
        "network": {
          "const": false
        },
        "write_package": {
          "const": false
        },
        "attestation_level": {
          "const": "host-orchestrator-recorded-not-cryptographic"
        }
      }
    },
    "unit_conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "source_unit",
        "normalized_source_unit",
        "target_unit",
        "quantity_kind",
        "basis",
        "scale",
        "offset",
        "input_decimal",
        "output_decimal"
      ],
      "properties": {
        "protocol": {
          "const": "science-units-v0.1"
        },
        "source_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "normalized_source_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "target_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quantity_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "basis": {
          "enum": [
            "not-applicable",
            "mass",
            "volume",
            "mole"
          ]
        },
        "scale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "offset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_decimal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "output_decimal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "calculation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "symbol_binding",
        "source",
        "original_quantity",
        "normalized_quantity",
        "decimal_value",
        "conversion"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
        },
        "symbol_binding": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "source": {
          "$ref": "#/$defs/calculation_source"
        },
        "original_quantity": {
          "$ref": "science-sidecar.schema.json#/$defs/quantity"
        },
        "normalized_quantity": {
          "$ref": "science-sidecar.schema.json#/$defs/quantity"
        },
        "decimal_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversion": {
          "$ref": "#/$defs/unit_conversion"
        }
      }
    },
    "predicate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "inputs",
        "children"
      ],
      "properties": {
        "status": {
          "enum": [
            "satisfied",
            "violated",
            "unknown"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "science-sidecar.schema.json#/$defs/quantity"
          }
        },
        "children": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/predicate_result"
          }
        }
      }
    },
    "condition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "status",
        "normalized_predicates_sha256",
        "inputs",
        "results"
      ],
      "properties": {
        "record_ref": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "status": {
          "enum": [
            "satisfied",
            "violated",
            "unknown"
          ]
        },
        "normalized_predicates_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "name",
              "value"
            ],
            "properties": {
              "source": {
                "enum": [
                  "request",
                  "property"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
              },
              "value": {
                "$ref": "science-sidecar.schema.json#/$defs/quantity"
              }
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/predicate_result"
          }
        }
      }
    },
    "property_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "selection_sha256",
        "observation",
        "material_state",
        "quantity",
        "decimal_value",
        "selected_points",
        "source_category",
        "value_qualifier",
        "source_evidence_refs",
        "uncertainty_status",
        "uncertainty_reason",
        "source_uncertainty_sha256",
        "execution_authorized"
      ],
      "properties": {
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "selection_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "observation": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "material_state": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "quantity": {
          "$ref": "science-sidecar.schema.json#/$defs/quantity"
        },
        "decimal_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "selected_points": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1e+100,
                "maximum": 1e+100
              },
              "y": {
                "type": "number",
                "minimum": -1e+100,
                "maximum": 1e+100
              }
            }
          }
        },
        "source_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value_qualifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_evidence_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "science-sidecar.schema.json#/$defs/evidence_ref"
          }
        },
        "uncertainty_status": {
          "enum": [
            "reported",
            "unavailable"
          ]
        },
        "uncertainty_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_uncertainty_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "execution_authorized": {
          "const": false
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "value",
        "unit",
        "dimension"
      ],
      "properties": {
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[A-Za-z][A-Za-z0-9_]{0,63}"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "dimension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "L",
            "M",
            "T",
            "I",
            "Theta",
            "N",
            "J"
          ],
          "properties": {
            "L": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "M": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "T": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "I": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "Theta": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "N": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            },
            "J": {
              "type": "integer",
              "minimum": -128,
              "maximum": 128
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol",
        "compiler_version",
        "status",
        "request_id",
        "request_sha256",
        "plan_sha256",
        "base_package",
        "sidecar_sha256",
        "source_formula_ref",
        "formula_card",
        "reviewed_ast_sha256",
        "engine_version",
        "engine_sha256",
        "runner_sha256",
        "input_bindings",
        "property_receipts",
        "condition_results",
        "execution_gate_refs",
        "tool_sha256s",
        "result",
        "output_quantity_kind",
        "output_frame",
        "runner_response_sha256",
        "assumptions",
        "warnings",
        "uncertainty_status",
        "uncertainty_reason",
        "isolation",
        "knowledge_verified",
        "production_knowledge_publication",
        "domain_accuracy",
        "execution_authorized",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "tkc.science-calculation-receipt/v0.1"
        },
        "protocol": {
          "const": "science-calculation-v0.1"
        },
        "compiler_version": {
          "const": "1.2.0-science-m3"
        },
        "status": {
          "const": "completed"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "request_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "plan_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "base_package": {
          "$ref": "science-consultation.schema.json#/$defs/fingerprint"
        },
        "sidecar_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "source_formula_ref": {
          "$ref": "science-sidecar.schema.json#/$defs/object_ref"
        },
        "formula_card": {
          "$ref": "#/$defs/calculation_record_ref"
        },
        "reviewed_ast_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "engine_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "runner_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "input_bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/calculation_input"
          }
        },
        "property_receipts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/property_receipt"
          }
        },
        "condition_results": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/condition_result"
          }
        },
        "execution_gate_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate",
              "sha256"
            ],
            "properties": {
              "gate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "[0-9a-f]{64}"
              }
            }
          }
        },
        "tool_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "[0-9a-f]{64}"
              }
            }
          }
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "output_quantity_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "output_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runner_response_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "assumptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "warnings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "uncertainty_status": {
          "const": "unavailable"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/portable-gold-review-revision.schema.json",
  "title": "TKC portable Gold review revision manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "revision_id", "revision", "status", "assurance_tier", "workpack_identity", "source_submissions", "curator", "comparison_receipt_sha256", "adjudication_receipt_sha256", "dispute_set_sha256", "decision_item_count", "resolved_decision_item_count", "gold_row_count", "file_hashes", "import_compatible", "verified_gold", "promotion_allowed", "release_included", "immutable", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.portable-gold-review-revision/v0.1"},
    "protocol": {"const": "portable-gold-review-v0.1"},
    "compiler_version": {"const": "0.14.3-portable-gold-review"},
    "revision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["paused", "accepted-for-import"]},
    "assurance_tier": {"const": "dual-source-adjudicated"},
    "workpack_identity": {"type": "object"},
    "source_submissions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "curator": {"type": "object"},
    "comparison_receipt_sha256": {"$ref": "#/$defs/hash"},
    "adjudication_receipt_sha256": {"$ref": "#/$defs/hash"},
    "dispute_set_sha256": {"$ref": "#/$defs/hash"},
    "decision_item_count": {"type": "integer", "minimum": 1},
    "resolved_decision_item_count": {"type": "integer", "minimum": 0},
    "gold_row_count": {"type": "integer", "minimum": 0},
    "file_hashes": {"type": "object", "minProperties": 5, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "import_compatible": {"type": "boolean"},
    "verified_gold": {"const": false},
    "promotion_allowed": {"const": false},
    "release_included": {"const": false},
    "immutable": {"const": true},
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

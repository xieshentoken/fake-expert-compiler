{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/portable-visual-recall-workbench.schema.json",
  "title": "TKC portable visual recall review workbench manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "compiler_version", "workbench_instance_id", "source_sha256", "source_pdf_filename", "bounded_scope", "reviewer", "proposer_instance", "bindings", "matching_policy", "review_policy", "pages", "status", "submission_count", "recall_status", "verified_gold", "promotion_allowed", "release_included", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.portable-visual-recall-workbench/v0.1"},
    "protocol": {"const": "portable-visual-recall-review-v0.1"},
    "compiler_version": {"const": "0.14.10-portable-visual-recall-review"},
    "workbench_instance_id": {"type": "string", "pattern": "^pvrw-[0-9a-f]{20}$"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "source_pdf_filename": {"type": "string", "minLength": 1},
    "bounded_scope": {"type": "object"},
    "reviewer": {"type": "object"},
    "proposer_instance": {"type": "string"},
    "bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "matching_policy": {"type": "object"},
    "review_policy": {"type": "object"},
    "pages": {"type": "array", "minItems": 1},
    "status": {"const": "paused-independent-recall-review"},
    "submission_count": {"const": 0},
    "recall_status": {"const": "not-run"},
    "verified_gold": {"const": false},
    "promotion_allowed": {"const": false},
    "release_included": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

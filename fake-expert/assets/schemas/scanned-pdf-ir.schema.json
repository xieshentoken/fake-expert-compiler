{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.5/scanned-pdf-ir.schema.json",
  "title": "TKC candidate-only scanned PDF intermediate representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler_version", "source_id", "source_sha256", "scope", "native_text_first", "backend_selection", "ocr_pages", "native_pages_preserved", "manual_review_pages", "render", "input_fingerprint", "quality_routing_sha256", "candidate_policy", "file_refs", "component_sha256"],
  "properties": {
    "schema_version": {"const": "tkc.scanned-pdf-ir/v0.2"},
    "compiler_version": {"const": "0.14.0-scan-pdf"},
    "source_id": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {"$ref": "#/$defs/scope"},
    "native_text_first": {"const": true},
    "native_text_extractor": {"type": "string", "minLength": 1},
    "backend_selection": {"$ref": "#/$defs/backendSelection"},
    "backend_roles": {"type": "object", "additionalProperties": {"type": "string"}},
    "ocr_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "native_pages_preserved": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "manual_review_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "render": {"type": "object", "additionalProperties": true},
    "input_fingerprint": {"$ref": "#/$defs/sha256"},
    "quality_routing_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_policy": {"type": "object", "additionalProperties": true},
    "file_refs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[^/\\\\]+$"}},
    "component_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "raster_regions": {"type": "array"},
    "runtime_contracts": {"type": "array"},
    "batch_receipts": {"type": "array"},
    "table_grids": {"type": "array"},
    "table_grid_bindings": {"type": "array"},
    "visual_candidates": {"type": "array"},
    "visual_gaps": {"type": "array"},
    "visual_conflicts": {"type": "array"},
    "result_adapters": {"type": "array"},
    "spread_split_contracts": {"type": "array", "items": {"type": "object"}},
    "scan_checkpoint": {"type": "object"},
    "reviewed_scan_structure": {"$ref": "#/$defs/structureReview"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_page", "end_page"],
      "properties": {"start_page": {"type": "integer", "minimum": 1}, "end_page": {"type": "integer", "minimum": 1}}
    },
    "backendSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "challenger", "baseline", "fallback_policy", "selection_is_explicit"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "challenger": {"type": ["string", "null"]},
        "baseline": {"type": ["string", "null"]},
        "fallback_policy": {"const": "forbidden"},
        "selection_is_explicit": {"const": true}
      }
    },
    "structureReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol", "source_sha256", "scope", "status", "segments", "candidate_only", "promotable", "structure_sha256"],
      "properties": {
        "schema_version": {"const": "tkc.scanned-pdf-structure-review/v0.1"},
        "protocol": {"const": "scanned-pdf-structure-review-v0.1"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "scope": {"$ref": "#/$defs/scope"},
        "status": {"enum": ["review-required", "accepted"]},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/structureSegment"}},
        "reviewer": {"$ref": "#/$defs/structureReviewer"},
        "candidate_only": {"const": true},
        "promotable": {"const": false},
        "structure_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "structureSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "physical_pages", "structure_order", "parent_id", "depth", "heading_resolution_id", "candidate_ids", "selected_candidate_id", "page_range", "bbox_pdf_points", "scan_locator", "review_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "physical_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "structure_order": {"type": "integer", "minimum": 0},
        "parent_id": {"type": ["string", "null"]},
        "depth": {"type": "integer", "minimum": 0},
        "heading_resolution_id": {"type": "string", "minLength": 1},
        "candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "selected_candidate_id": {"type": ["string", "null"]},
        "page_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "bbox_pdf_points": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "scan_locator": {"$ref": "#/$defs/scanLocatorOrNull"},
        "review_status": {"enum": ["review-required", "accepted"]}
      }
    },
    "scanLocator": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_sha256", "physical_page", "render_sha256", "render_dpi", "bbox_pdf_points", "bbox_sha256", "coordinate_transform_id", "ocr_observation_ids", "transcript_span_ids", "transcript_sha256", "backend_id", "model_identity_sha256", "configuration_sha256", "coordinate_transform_scope", "render_receipt", "render_receipt_sha256", "coordinate_transform", "coordinate_transform_sha256", "transcript_row_commitments", "transcript_commitment_sha256", "observation_commitments", "backend_receipt_id", "backend_receipt_sha256", "backend_receipt_binding_sha256", "runtime_contract_sha256", "worker_sha256", "qualification_receipt_sha256", "runtime_binding_kind"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "physical_page": {"type": "integer", "minimum": 1},
        "render_sha256": {"$ref": "#/$defs/sha256"},
        "render_dpi": {"type": "integer", "minimum": 1},
        "bbox_pdf_points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "bbox_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_transform_id": {"type": "string", "minLength": 1},
        "ocr_observation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "transcript_span_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "transcript_sha256": {"$ref": "#/$defs/sha256"},
        "backend_id": {"type": "string", "minLength": 1},
        "model_identity_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_transform_scope": {"const": "page-render"},
        "render_receipt": {"type": "object", "additionalProperties": true},
        "render_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_transform": {"type": "object", "additionalProperties": true},
        "coordinate_transform_sha256": {"$ref": "#/$defs/sha256"},
        "transcript_row_commitments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
        "transcript_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "observation_commitments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
        "backend_receipt_id": {"type": "string", "minLength": 1},
        "backend_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "backend_receipt_binding_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_contract_sha256": {"$ref": "#/$defs/sha256"},
        "worker_sha256": {"$ref": "#/$defs/sha256"},
        "qualification_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "runtime_binding_kind": {"enum": ["external-local-runtime", "synthetic-test-only"]}
      }
    },
    "scanLocatorOrNull": {"$ref": "#/$defs/scanLocator"},
    "structureReviewer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["proposer_instance", "reviewer_instance", "review_session_id", "review_plan_sha256", "review_input_sha256", "candidate_sha256", "external_fragment_sha256", "attestation_sha256", "review_independence_basis"],
      "properties": {
        "proposer_instance": {"type": "string", "minLength": 1},
        "reviewer_instance": {"type": "string", "minLength": 1},
        "review_session_id": {"type": "string", "minLength": 1},
        "review_plan_sha256": {"$ref": "#/$defs/sha256"},
        "review_input_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "candidate_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "external_fragment_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "review_independence_basis": {"const": "host-plan-proposer-reviewer-separation-v1"}
      }
    }
  }
}

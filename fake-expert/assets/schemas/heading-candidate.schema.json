{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.2/heading-candidate.schema.json",
  "title": "TKC hash-locked heading locator candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "source_sha256", "segment_id", "physical_page",
    "raw_title", "requested_title", "matching_title", "match_normalization", "char_span", "page_text_sha256",
    "span_sha256", "line_index", "line_sha256", "line_boundary", "role", "candidate_method",
    "parser", "render_sha256", "coordinate_space", "bbox", "constraints", "score",
    "selection_reason", "candidate_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tkc.heading-candidate/v0.2"},
    "candidate_id": {"type": "string", "pattern": "^hgc-[0-9a-f]{20}$"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "segment_id": {"type": "string", "minLength": 1},
    "physical_page": {"type": "integer", "minimum": 1},
    "raw_title": {"type": "string", "minLength": 1},
    "requested_title": {"type": "string", "minLength": 1},
    "matching_title": {"type": "string", "minLength": 1},
    "match_normalization": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "value", "requested_value"],
      "properties": {
        "profile": {"const": "nfkc-casefold-dash-ligature-dehyphenated-v2"},
        "value": {"type": "string", "minLength": 1},
        "requested_value": {"type": "string", "minLength": 1}
      }
    },
    "char_span": {"$ref": "#/$defs/span"},
    "page_text_sha256": {"$ref": "#/$defs/sha256"},
    "span_sha256": {"$ref": "#/$defs/sha256"},
    "line_index": {"type": "integer", "minimum": 0},
    "line_sha256": {"$ref": "#/$defs/sha256"},
    "line_boundary": {"enum": ["exact-line", "line-boundary", "substring"]},
    "role": {"enum": ["body-heading", "inline-heading-candidate", "running-header", "footer", "body-text"]},
    "candidate_method": {"enum": ["normalized-exact", "unicode-ligature-equivalent", "dehyphenated-line-match", "compact-token-boundary-match"]},
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "canonical_text_extractor"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "canonical_text_extractor": {"type": "string", "minLength": 1}
      }
    },
    "render_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "coordinate_space": {"type": ["string", "null"]},
    "bbox": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "layout_line": {"type": ["string", "null"]},
    "layout_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "object"},
    "score": {"type": "integer"},
    "source_kind": {"enum": ["native-text", "scan-ocr-candidate"]},
    "scan_locator": {"$ref": "#/$defs/scanLocator"},
    "selection_reason": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {
      "type": "array", "prefixItems": [
        {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}
      ], "minItems": 2, "maxItems": 2
    },
    "scanLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "physical_page", "render_sha256", "render_dpi", "bbox_pdf_points", "coordinate_transform_id", "ocr_observation_ids", "transcript_span_ids", "transcript_sha256", "backend_id", "model_identity_sha256", "configuration_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "physical_page": {"type": "integer", "minimum": 1},
        "render_sha256": {"$ref": "#/$defs/sha256"},
        "render_dpi": {"type": "integer", "minimum": 1},
        "bbox_pdf_points": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "bbox_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_transform_id": {"type": "string", "pattern": "^pct-[0-9a-f]{20}$"},
        "ocr_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "transcript_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "transcript_sha256": {"$ref": "#/$defs/sha256"},
        "backend_id": {"type": "string", "minLength": 1},
        "model_identity_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_transform_scope": {"enum": ["crop-local", "page-render"]}
      }
    }
  }
}

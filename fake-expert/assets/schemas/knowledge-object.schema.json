{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/knowledge-object.schema.json",
  "title": "TKC Knowledge Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "statement",
    "source_ids",
    "evidence_ids",
    "assumptions",
    "valid_when",
    "fails_when",
    "confidence",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "tkc.expert-skill/v0.1"},
    "id": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "Definition",
        "Concept",
        "Claim",
        "Equation",
        "Assumption",
        "Exception",
        "Method",
        "Procedure",
        "DecisionRule"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "origin": {"enum": ["source-explicit", "source-paraphrase", "compiler-derived"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "valid_when": {"type": "array", "items": {"type": "string"}},
    "fails_when": {"type": "array", "items": {"type": "string"}},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_pages", "excluded_conclusions"],
      "properties": {
        "physical_pages": {
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "minItems": 2,
          "maxItems": 2
        },
        "excluded_conclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "formula": {"type": ["object", "null"]},
    "visual_task_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "visual_object_ids": {"type": "array", "items": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "uniqueItems": true},
    "table_cell_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "series_ids": {"type": "array", "items": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "uniqueItems": true},
    "visual_relation_ids": {"type": "array", "items": {"type": "string", "pattern": "^vr-[0-9a-f]{20}$"}, "uniqueItems": true},
    "relation_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "table_grid_ids": {"type": "array", "items": {"type": "string", "pattern": "^tg-[0-9a-f]{20}$"}, "uniqueItems": true},
    "table_grid_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "render_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "crop_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "bbox_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "visual_review_attestation_ids": {"type": "array", "items": {"type": "string", "pattern": "^vra-[0-9a-f]{20}$"}, "uniqueItems": true},
    "review_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_level",
        "reviewer_instance",
        "item_sha256",
        "review_input_sha256",
        "review_bundle_sha256"
      ],
      "properties": {
        "attestation_level": {"const": "host-orchestrator-recorded-not-cryptographic"},
        "reviewer_instance": {"type": "string", "minLength": 1},
        "item_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer_instances": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "attestation_ids": {"type": "array", "items": {"type": "string", "pattern": "^rat-[0-9a-f]{20}$"}, "uniqueItems": true},
        "semantic_assurance_protocol": {"const": "atomic-support-review-v2"},
        "visual_object_ids": {"type": "array", "items": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "uniqueItems": true},
        "table_cell_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "series_ids": {"type": "array", "items": {"type": "string", "pattern": "^vo-[0-9a-f]{20}$"}, "uniqueItems": true},
        "visual_relation_ids": {"type": "array", "items": {"type": "string", "pattern": "^vr-[0-9a-f]{20}$"}, "uniqueItems": true},
        "relation_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "table_grid_ids": {"type": "array", "items": {"type": "string", "pattern": "^tg-[0-9a-f]{20}$"}, "uniqueItems": true},
        "table_grid_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "render_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "crop_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "bbox_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "visual_review_protocol": {"const": "visual-review-attestation-v0.2"},
        "visual_review_attestation_ids": {"type": "array", "items": {"type": "string", "pattern": "^vra-[0-9a-f]{20}$"}, "uniqueItems": true}
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_id"],
        "properties": {
          "type": {
            "enum": [
              "is_a",
              "part_of",
              "depends_on",
              "derived_from",
              "causes",
              "supports",
              "contradicts",
              "valid_when",
              "fails_when",
              "used_for",
              "equivalent_to",
              "example_of",
              "related_to"
            ]
          },
          "target_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction", "interpretation"],
      "properties": {
        "extraction": {"type": "number", "minimum": 0, "maximum": 1},
        "interpretation": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "status": {"type": "string", "minLength": 1}
  }
}

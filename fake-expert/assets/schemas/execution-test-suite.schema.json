{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkc/v0.1/execution-test-suite.schema.json",
  "title": "TKC Independently Authored Formula Execution Tests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issued_at", "author", "cases"],
  "properties": {
    "schema_version": {"const": "tkc.execution-test-suite/v0.1"},
    "issued_at": {"type": "string", "format": "date-time"},
    "author": {
      "type": "object", "additionalProperties": false,
      "required": ["instance", "attestation_level"],
      "properties": {"instance": {"type": "string", "minLength": 1}, "attestation_level": {"const": "host-orchestrator-recorded-not-cryptographic"}}
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "object_id", "inputs", "expected", "tolerance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
          "object_id": {"type": "string", "minLength": 1},
          "inputs": {"type": "object"},
          "expected": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": ["string", "number"]}, "unit": {"type": "string"}}},
          "tolerance": {"type": "object", "additionalProperties": false, "required": ["absolute", "relative"], "properties": {"absolute": {"type": ["string", "number"]}, "relative": {"type": ["string", "number"]}}}
        }
      }
    }
  }
}
